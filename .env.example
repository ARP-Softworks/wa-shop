# Copy to .env and fill values. Do not commit real secrets.
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/washop
SPRING_DATASOURCE_USERNAME=washop
SPRING_DATASOURCE_PASSWORD=washop

# Session cookie (HttpOnly). Auth is cookie-based — not JWT in localStorage.
APP_SESSION_TIMEOUT=8h
APP_COOKIE_SESSION_NAME=WASESSION
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax

# Login lockout (in-memory; ready to replace with distributed rate limiting)
APP_LOGIN_MAX_FAILED_ATTEMPTS=5
APP_LOGIN_LOCK_DURATION_SECONDS=900

APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
APP_WHATSAPP_PHONE=5989XXXXXXX
APP_PUBLIC_BASE_URL=http://localhost:8080

# Canonical public site URL for SEO (sitemap, robots, OG, canonical tags).
# Prefer HTTPS in production. Falls back to APP_PUBLIC_BASE_URL if empty.
PUBLIC_SITE_URL=http://localhost:8080

# Optional Search Console / Bing verification meta content (not scripts).
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Optional analytics — leave empty to disable script loading.
# GOOGLE_ANALYTICS_ID=
# GOOGLE_TAG_MANAGER_ID=

# Media storage — never expose CLOUDINARY_* / secrets to the frontend.
# local = filesystem under MEDIA_LOCAL_DIR (dev only)
# cloudinary = production provider
MEDIA_PROVIDER=local
# APP_MEDIA_PROVIDER=local
MEDIA_MAX_FILE_SIZE=5242880
MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/webp
MEDIA_LOCAL_DIR=./data/media

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional first admin (only created if email does not exist). Never commit real values.
# APP_ADMIN_BOOTSTRAP_EMAIL=
# APP_ADMIN_BOOTSTRAP_PASSWORD=

# Checkout / Mercado Pago (optional until payments go live)
ORDER_PENDING_EXPIRY_MINUTES=45
ORDER_CHECKOUT_IP_MAX_PER_WINDOW=8
ORDER_CHECKOUT_PHONE_MAX_PER_WINDOW=4
ORDER_CHECKOUT_WINDOW_SECONDS=900
# PAYMENT_PROVIDER=mercadopago
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=
# MERCADOPAGO_WEBHOOK_SECRET=
